{
  "name": "best-todo",
  "version": "1.0.0",
  "private": true,
  "description": "日本語のTo Doデスクトップクライアント",
  "author": "Best ToDo contributors",
  "main": "electron/main.js",
  "desktopName": "best-todo.desktop",
  "build": {
    "appId": "com.besttodo.desktop",
    "productName": "Best ToDo",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "artifactName": "best-todo-${version}-${arch}.${ext}",
    "files": [
      "electron/**",
      "public/**",
      "src/frontend-server.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "best-todo-setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "best-todo",
      "maintainer": "Best ToDo contributors",
      "syncDesktopName": true
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "desktop": "electron .",
    "dev:desktop": "electron . --dev",
    "pack:desktop": "electron-builder --dir",
    "build:desktop:win": "electron-builder --win",
    "build:desktop:linux": "electron-builder --linux",
    "test:desktop": "node --test test/desktop.test.js",
    "test:frontend": "node --test test/frontend.test.js",
    "dev": "node --env-file=.env --watch server.js",
    "start:frontend": "node src/frontend.js",
    "dev:frontend": "node --watch src/frontend.js",
    "test": "npm run test:unit && npm run test:frontend && npm run test:api && npm run test:e2e",
    "test:unit": "node --test test/task-utils.test.js test/csv.test.js",
    "test:api": "node --test test/api.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
